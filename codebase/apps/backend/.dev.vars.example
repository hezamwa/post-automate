# Copy to .dev.vars (gitignored) and fill in for local dev. Names only here — never commit values (NFR-11.2).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GROK_API_KEY=
MANUS_API_KEY=
TAVILY_API_KEY=<...>
# One Editor token per creator's Sanity project (FR-8.4): SANITY_TOKEN_<PROJECTID>
SANITY_TOKEN_R9ZDT0S0=
SANITY_TOKEN_5GZ3NGJS=
JWT_SIGNING_KEY=
FCM_SERVICE_ACCOUNT=
SANITY_WEBHOOK_SECRET=
# Local Postgres connection for dev (Hyperdrive binding replaces this in production)
DATABASE_URL=
# Neon account API key — used by setup/tooling scripts only, never a Worker secret
NEON_API_KEY=
# Social publishing (requirements §18, runbook §6): the platforms' OAuth app credentials, and
# SOCIAL_TOKEN_KEY (openssl rand -base64 32) which encrypts every stored user token at rest
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SOCIAL_TOKEN_KEY=
# Optional: LinkedIn API version (YYYYMM) when the default in code is retired
LINKEDIN_API_VERSION=
